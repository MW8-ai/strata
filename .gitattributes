# Keep the archive byte-identical across platforms.
#
# Content is parsed by scripts/verify.mjs and by Astro's frontmatter reader, and
# checked out on Windows with the default core.autocrlf it would arrive as CRLF.
# The scripts tolerate that now, but normalising here means a Windows clone and
# a Linux CI runner hash the same file, so nobody opens a pull request whose diff
# is the whole repository.
* text=auto eol=lf

# Generated by npm, never hand-merged.
package-lock.json -diff linguist-generated=true

# Feed lane output is machine-written. Keep it out of diffs for review sanity.
data/feed/latest.json linguist-generated=true
data/feed/archive/*.json linguist-generated=true
