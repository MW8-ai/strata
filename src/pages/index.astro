---
/**
 * Landing page = the state of the practice, not a news feed.
 *
 * The design target is someone who last looked six months ago. They should
 * be able to answer three questions without scrolling twice: what should I
 * reach for now, what did I learn that is no longer the whole answer, and
 * what is not ready yet.
 */
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CoreColumn from '../components/CoreColumn.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const methods = (await getCollection('methods')).sort((a, b) => a.data.order - b.data.order);
const vendors = await getCollection('vendors');
const events = (await getCollection('events')).sort((a, b) => b.data.date.localeCompare(a.data.date));

/** Matches the compact "2026-05" style the core column's hover label uses; the
 *  full date lives on the timeline page each band links to. */
const compactDate = (date: string, precision: string) => {
  const [y, m] = date.split('-');
  if (precision === 'year') return y;
  if (precision === 'quarter') return `Q${Math.floor((parseInt(m, 10) - 1) / 3) + 1} ${y}`;
  return `${y}-${m}`;
};

/** One band per event, newest first so it renders at the top of the column,
 *  oldest last so it settles at the bottom. Methods with no dated event of
 *  their own are not represented; a band with no date would be exactly the
 *  padding CLAUDE.md's "unknown is not none" rule exists to prevent. */
const bands = events.map((e) => ({
  label: `${compactDate(e.data.date, e.data.date_precision)} · ${e.data.title}`,
  klass: e.data.class,
  verification: e.data.verification,
  href: `${base}/timeline#${e.id.replace(/\.md$/, '')}`,
}));

const by = (l: string) => methods.filter((m) => m.data.lifecycle === l);
const current = by('current');
const additive = by('additive');
const retired = [...by('superseded'), ...by('withdrawn')];
const notReady = methods.filter((m) => m.data.maturity !== 'recommended' && m.data.lifecycle !== 'superseded');

const criticalCount = methods.reduce(
  (n, m) => n + m.data.caveats.filter((c) => c.severity === 'critical').length, 0
);
const unreviewed = methods.filter((m) => m.data.review.status === 'unreviewed').length;

const vendorRows = await Promise.all(
  vendors.map(async (v) => ({
    v,
    def: v.data.current_default ? await getEntry(v.data.current_default) : null,
  }))
);

const href = (m: { id: string }) => `${base}/methods/${m.id.replace(/\.md$/, '')}`;
const updated = new Date().toISOString().slice(0, 10);
---
<Base title="State of the practice" current="state">
  <section class="core">
    <CoreColumn bands={bands} />
    <div class="core__lede">
      <span class="eyebrow">Reviewed {updated} · Cornerstone Method component</span>
      <h1 style="max-inline-size:16ch">If you have been away six months, start here.</h1>
      <p>
        Every method on this site carries two independent statuses. <strong>Maturity</strong> is what
        the vendor says about readiness. <strong>Lifecycle</strong> is whether you should still reach
        for it. They disagree constantly, and the disagreement is the useful part.
      </p>
    </div>
  </section>
  <p class="meta" style="margin-block:0 1rem">
    {methods.length} methods · {criticalCount} critical caveats on file · {unreviewed} awaiting human review
  </p>

  <section>
    <h2 class="prose" style="font-size:var(--step-2)">Reach for these first</h2>
    <p class="prose" style="color:var(--ink-soft)">Current default. Nothing has replaced them and nothing is queued to.</p>
    <div class="board">
      {current.map((m) => (
        <a class="mcard" href={href(m)} data-lifecycle={m.data.lifecycle}>
          <h3>{m.data.name}</h3>
          <p>{m.data.one_line}</p>
          <span class="mcard__note">since {m.data.introduced} · {m.data.maturity}</span>
          {m.data.caveats.some((c) => c.severity === 'critical') && (
            <span class="mcard__flag">critical caveat</span>
          )}
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="prose" style="font-size:var(--step-2)">Still correct, no longer the whole answer</h2>
    <p class="prose" style="color:var(--ink-soft)">
      Additive. Keep using these. They were relieved of jobs they were never good at, not replaced.
      This is the category most people get wrong after a gap.
    </p>
    <div class="board">
      {additive.map((m) => (
        <a class="mcard" href={href(m)} data-lifecycle={m.data.lifecycle}>
          <h3>{m.data.name}</h3>
          <p>{m.data.one_line}</p>
          <span class="mcard__note">since {m.data.introduced} · {m.data.maturity}</span>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="prose" style="font-size:var(--step-2)">Do not build on these yet</h2>
    <p class="prose" style="color:var(--ink-soft)">
      Preview, in development, or unproven. Worth understanding, worth prototyping against,
      not worth a production dependency.
    </p>
    <div class="board">
      {notReady.map((m) => (
        <a class="mcard" href={href(m)} data-lifecycle={m.data.lifecycle}>
          <h3>{m.data.name}</h3>
          <p>{m.data.one_line}</p>
          <span class="mcard__note">{m.data.maturity} · lifecycle {m.data.lifecycle}</span>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="prose" style="font-size:var(--step-2)">Superseded</h2>
    <p class="prose" style="color:var(--ink-soft)">Something replaced these for the same job. Read them for the argument, not the advice.</p>
    <div class="board">
      {retired.map((m) => (
        <a class="mcard" href={href(m)} data-lifecycle={m.data.lifecycle}>
          <h3>{m.data.name}</h3>
          <p>{m.data.one_line}</p>
          <span class="mcard__note">{m.data.introduced} to {m.data.sunset ?? 'unknown'}</span>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="prose" style="font-size:var(--step-2)">Where each vendor currently sits</h2>
    <p class="prose" style="color:var(--ink-soft)">
      The method each vendor documents as its default today. No scores and no ranking:
      a stance, sourced, so you can build against the right one.
    </p>
    {vendorRows.map(({ v, def }) => (
      <div class="state-row">
        <div>
          <h3>{v.data.name}</h3>
          <span class="meta">{def ? def.data.maturity : 'unknown'}</span>
        </div>
        <div>
          <p style="margin:0 0 .5rem">{v.data.stance}</p>
          {def
            ? <p class="meta">Current default: <a href={href(def)}>{def.data.name}</a></p>
            : <p class="meta">No default on file. Unknown, not none.</p>}
        </div>
      </div>
    ))}
  </section>

  <div class="callout" style="margin-block-start:3rem">
    Nothing here is a recommendation to adopt. Every method page lists what is weak and what is
    missing alongside what works, and the critical caveats are the part to read before a
    production decision.
  </div>
</Base>
