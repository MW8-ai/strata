---
/**
 * Every caveat across every method, in one place, grouped by scope.
 *
 * The engineer question this answers is "show me every permissioning
 * concern in the whole architecture", which no per-method page can.
 * Filterable client-side so it stays useful without a backend.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const methods = await getCollection('methods');

const all = methods.flatMap((m) =>
  m.data.caveats.map((c) => ({ ...c, method: m.data.name, slug: m.id.replace(/\.md$/, '') }))
);
const rank = { critical: 0, warning: 1, note: 2 } as const;
const sorted = [...all].sort(
  (a, b) => rank[a.severity] - rank[b.severity] || a.scope.localeCompare(b.scope)
);
const scopes = [...new Set(sorted.map((c) => c.scope))].sort();
const n = (s: string) => all.filter((c) => c.severity === s).length;
const gates = all.filter((c) => c.compliance_relevant).length;
const withCheck = all.filter((c) => c.check).length;
---
<Base title="Caveat register" current="register">
  <section style="padding-block:3rem 0">
    <span class="eyebrow">Every caveat, every method</span>
    <h1 style="font-size:var(--step-3);max-inline-size:22ch">The whole risk surface on one page.</h1>
    <p class="prose" style="color:var(--ink-soft);margin-block-start:1rem">
      Per-method pages answer "what should I know about this one." This page answers
      "show me every permissioning concern in the architecture," which is the question you
      have the week before a review.
    </p>

    <div class="tally">
      <div><b>{n('critical')}</b><span style="color:var(--sev-critical)">critical</span></div>
      <div><b>{n('warning')}</b><span style="color:var(--sev-warning)">warning</span></div>
      <div><b>{n('note')}</b><span>note</span></div>
      <div><b>{gates}</b><span style="color:var(--sev-critical)">compliance gates</span></div>
      <div><b>{withCheck}/{all.length}</b><span>have a concrete check</span></div>
    </div>

    <div class="badges" role="group" aria-label="Filter by severity">
      <button class="badge" data-filter="all" aria-pressed="true"><span class="badge__v">all</span></button>
      <button class="badge" data-filter="critical" aria-pressed="false"><span class="badge__v">critical only</span></button>
      <button class="badge" data-filter="compliance" aria-pressed="false"><span class="badge__v">compliance gates</span></button>
      <button class="badge" data-filter="unchecked" aria-pressed="false"><span class="badge__v">no check yet</span></button>
    </div>
  </section>

  {scopes.map((scope) => (
    <section class="caveats" data-scope-group={scope}>
      <h2 class="eyebrow" style="margin-block-start:2rem">{scope}</h2>
      <ul>
        {sorted.filter((c) => c.scope === scope).map((c) => (
          <li
            class="caveat"
            data-severity={c.severity}
            data-compliance={String(c.compliance_relevant)}
            data-checked={String(Boolean(c.check))}
          >
            <div class="caveat__head">
              <span class="caveat__sev">{c.severity}</span>
              {c.compliance_relevant && <span class="caveat__compliance">compliance gate</span>}
            </div>
            <p>{c.text}</p>
            {c.check && (
              <div class="caveat__check">
                <span class="caveat__check-k">how to check</span>
                <p>{c.check}</p>
              </div>
            )}
            <a class="caveat__src" href={`${base}/methods/${c.slug}`}>{c.method}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <script>
    const items = document.querySelectorAll<HTMLElement>('.caveat');
    const groups = document.querySelectorAll<HTMLElement>('[data-scope-group]');
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');

    const test = (el: HTMLElement, f: string) =>
      f === 'all' ? true
      : f === 'critical' ? el.dataset.severity === 'critical'
      : f === 'compliance' ? el.dataset.compliance === 'true'
      : el.dataset.checked === 'false';

    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter!;
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        items.forEach((el) => { el.hidden = !test(el, f); });
        // Hide a scope heading once everything under it is filtered out.
        groups.forEach((g) => {
          g.hidden = ![...g.querySelectorAll<HTMLElement>('.caveat')].some((el) => !el.hidden);
        });
      })
    );
  </script>
</Base>
